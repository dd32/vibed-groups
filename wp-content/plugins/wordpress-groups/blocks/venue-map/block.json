{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "groups/venue-map",
	"version": "0.1.0",
	"title": "Venue Map",
	"category": "widgets",
	"icon": "location-alt",
	"description": "Displays an interactive OpenStreetMap map for a venue location with marker and address.",
	"textdomain": "wordpress-groups",
	"attributes": {
		"venueId": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
