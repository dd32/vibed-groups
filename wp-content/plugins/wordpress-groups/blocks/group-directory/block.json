{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "groups/group-directory",
	"version": "0.1.0",
	"title": "Group Directory",
	"category": "widgets",
	"icon": "groups",
	"description": "Network-wide filterable listing of WordPress community groups with search and pagination.",
	"textdomain": "wordpress-groups",
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 12
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
