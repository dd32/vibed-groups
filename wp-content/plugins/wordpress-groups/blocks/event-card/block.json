{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "groups/event-card",
	"version": "0.1.0",
	"title": "Event Card",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Displays an event summary card with title, date/time, venue, RSVP count, and status.",
	"textdomain": "wordpress-groups",
	"attributes": {
		"eventId": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
