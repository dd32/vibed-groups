parameters:
    # Start at level 5 (moderate strictness).
    level: 5

    paths:
        - includes/

    excludePaths:
        - includes/class-cli.php

    # WordPress stubs are needed for WP functions/classes.
    scanDirectories:
        - ../../../../wp-includes/
        - ../../../../wp-admin/includes/

    # Ignore WordPress dynamic patterns.
    ignoreErrors:
        - '#Function apply_filters invoked with#'
        - '#Function do_action invoked with#'
        - '#Call to an undefined method wpdb::#'
